{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected-branch-commit.sh\"",
            "statusMessage": "Checking the git command"
          }
        ]
      }
    ]
  }
}
