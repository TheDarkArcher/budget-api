# Copy this file to .env and adjust the values for your machine.

# Credentials for the Postgres container (compose.yaml), also used to build
# DATABASE_URL below. URL-encode the password if it has special characters.
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_DB=budget

# Host the app connects to when running on your machine.
POSTGRES_HOST=localhost

# Port on your machine that the Postgres container is published on (for
# psql and for running the app outside Docker). Change it if 5432 is already
# in use.
POSTGRES_HOST_PORT=5432

# Seconds a request waits for a free database connection before failing.
DATABASE_POOL_TIMEOUT=5

# Seconds a single SQL statement may run before the database cancels it.
DATABASE_STATEMENT_TIMEOUT=30

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL connection URL, in plain postgresql:// form (the app adds the
# psycopg driver itself, and the same URL works with psql and pg_dump).
# Built from the POSTGRES_* values above, so it normally needs no editing.
# Inside Docker, compose.yaml overrides it to point at the db service.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_HOST_PORT}/${POSTGRES_DB}

# Logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Comma-separated addresses or networks of the reverse proxies whose
# X-Forwarded-For and X-Forwarded-Proto headers uvicorn trusts. Read by
# uvicorn itself, not the app. Headers from anywhere else are ignored.
# Defaults to 127.0.0.1,::1; locally there is no proxy, so leave it as is.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
