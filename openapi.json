{
  "openapi": "3.1.0",
  "info": {
    "title": "Budget Tracker API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get liveness",
        "description": "Report whether the app process is up. Doesn't check any subsystem; use `/health/ready` for that.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "The app is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get readiness",
        "description": "Report whether the app and each subsystem it depends on are ready, with each check's result.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "All subsystems are healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "A subsystem is unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get the current user",
        "description": "Return the user the request acts as.",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "The current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "403": {
            "description": "The current user is not authorised",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckResult": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "latencyMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latencyms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CheckResult",
        "description": "Result of a single subsystem check."
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok",
          "error"
        ],
        "title": "HealthStatus",
        "description": "Status of the app or one of its subsystems."
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "build": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "LivenessResponse",
        "description": "Whether the app process is up and serving requests."
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "A problem type, used as an identifier: a path-absolute URI reference such as `/problems/name-conflict` for 409 and 422 responses, and `about:blank` for every other status. Clients should accept types they don't know."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "A short, fixed summary of the problem type, or the HTTP status phrase for `about:blank`. For display only; match on `type`."
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "The HTTP status code of the response."
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "What went wrong in this request, safe to show to the user."
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemErrorEntry"
            },
            "type": "array",
            "title": "Errors",
            "description": "The problems with individual fields or parameters. Present only when the request had any."
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "title": "Problem",
        "description": "An error response, sent as `application/problem+json` (RFC 9457)."
      },
      "ProblemErrorEntry": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "What is wrong, safe to show to the user."
          },
          "pointer": {
            "type": "string",
            "title": "Pointer",
            "description": "A JSON Pointer (RFC 6901) into the request body, using its camelCase names, such as `/lines/1/itemSizeId`. Present when the problem is in the body."
          },
          "parameter": {
            "type": "string",
            "title": "Parameter",
            "description": "The name of the query, path or header parameter, as sent, such as `pageSize`. Present when the problem is in a parameter."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ProblemErrorEntry",
        "description": "One problem with a request, located by either `pointer` or `parameter`."
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "build": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "checks"
        ],
        "title": "ReadinessResponse",
        "description": "Whether the app and each subsystem it depends on are ready."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "UserResponse",
        "description": "A user, as returned by the API."
      }
    }
  }
}
