{
  "openapi": "3.1.0",
  "info": {
    "title": "Budget Tracker API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get liveness",
        "description": "Report whether the app process is up. Doesn't check any subsystem; use `/health/ready` for that.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "The app is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get readiness",
        "description": "Report whether the app and each subsystem it depends on are ready, with each check's result.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "All subsystems are healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "A subsystem is unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payees": {
      "get": {
        "tags": [
          "payees"
        ],
        "summary": "List payees",
        "description": "Return one page of the current user's payees, active ones by default, sorted by name.",
        "operationId": "listPayees",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "The page number, starting at 1.",
              "default": 1,
              "title": "Page"
            },
            "description": "The page number, starting at 1."
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "The most records a page can hold.",
              "default": 25,
              "title": "Pagesize"
            },
            "description": "The most records a page can hold."
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "description": "Lists only records whose name contains this text, ignoring case. Surrounding whitespace is trimmed, and blank text is ignored. At most 100 characters after trimming, and no NUL character.",
              "default": "",
              "title": "Q"
            },
            "description": "Lists only records whose name contains this text, ignoring case. Surrounding whitespace is trimmed, and blank text is ignored. At most 100 characters after trimming, and no NUL character."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/NameSort",
              "description": "What to sort the list by.",
              "default": "name"
            },
            "description": "What to sort the list by."
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder",
              "description": "The direction to sort in. Records that sort equally are ordered by id, in the same direction.",
              "default": "asc"
            },
            "description": "The direction to sort in. Records that sort equally are ordered by id, in the same direction."
          },
          {
            "name": "archived",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ArchivedFilter",
              "description": "Whether to list active records (`false`), archived records (`true`) or both (`all`).",
              "default": "false"
            },
            "description": "Whether to list active records (`false`), archived records (`true`) or both (`all`)."
          }
        ],
        "responses": {
          "200": {
            "description": "The page of payees",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayeePage"
                }
              }
            }
          },
          "403": {
            "description": "The current user is not authorised",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "payees"
        ],
        "summary": "Create a payee",
        "description": "Create an active payee for the current user.",
        "operationId": "createPayee",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "title": "Idempotency-Key"
            },
            "description": "Makes the request safe to repeat: a repeat with the same key and request returns the original response instead of creating another record, and the same key with a different request returns a 422 `/problems/idempotency-key-mismatch`. A repeat sent while the first request is still running waits for it. Choose a unique key, such as a UUID, for each record to create. A key lasts 24 hours, and only successful creates are stored, so a failed request can be sent again with the same key. The key is the header's text as sent, including any quotes, and the header may be sent only once."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayeeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new payee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayeeResponse"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "The new payee's path.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "The current user is not authorised",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The current user already has a payee with this name, ignoring case, archived or not; `existing` names it",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PayeeNameConflictProblem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payees/{payeeId}": {
      "get": {
        "tags": [
          "payees"
        ],
        "summary": "Get a payee",
        "description": "Return one of the current user's payees, archived or not.",
        "operationId": "getPayee",
        "parameters": [
          {
            "name": "payeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Payeeid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The payee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayeeResponse"
                }
              }
            }
          },
          "403": {
            "description": "The current user is not authorised",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The current user has no payee with this id, or the id is malformed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "payees"
        ],
        "summary": "Update a payee",
        "description": "Update the entire payee, one of the current user's active ones. Archive or unarchive a payee with its own endpoints.",
        "operationId": "updatePayee",
        "parameters": [
          {
            "name": "payeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Payeeid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayeeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated payee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayeeResponse"
                }
              }
            }
          },
          "403": {
            "description": "The current user is not authorised",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The current user has no payee with this id, or the id is malformed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The payee is archived (`/problems/archived`), or the current user already has another payee with this name, ignoring case, archived or not (`/problems/name-conflict`, with `existing` naming it)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get the current user",
        "description": "Return the user the request acts as.",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "The current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "403": {
            "description": "The current user is not authorised",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArchivedFilter": {
        "type": "string",
        "enum": [
          "false",
          "true",
          "all"
        ],
        "title": "ArchivedFilter",
        "description": "Which records a list holds: active, archived or both."
      },
      "CheckResult": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "latencyMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latencyms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CheckResult",
        "description": "Result of a single subsystem check."
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok",
          "error"
        ],
        "title": "HealthStatus",
        "description": "Status of the app or one of its subsystems."
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "build": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "LivenessResponse",
        "description": "Whether the app process is up and serving requests."
      },
      "NameSort": {
        "type": "string",
        "enum": [
          "name"
        ],
        "title": "NameSort",
        "description": "What a list that only sorts by name can be sorted by."
      },
      "PayeeNameConflictProblem": {
        "properties": {
          "type": {
            "type": "string",
            "const": "/problems/name-conflict",
            "title": "Type",
            "description": "A problem type, used as an identifier: a path-absolute URI reference such as `/problems/name-conflict` for 409 and 422 responses, and `about:blank` for every other status. Clients should accept types they don't know."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "A short, fixed summary of the problem type, or the HTTP status phrase for `about:blank`. For display only; match on `type`."
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "The HTTP status code of the response."
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "What went wrong in this request, safe to show to the user."
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemErrorEntry"
            },
            "type": "array",
            "title": "Errors",
            "description": "The problems with individual fields or parameters. Present only when the request had any."
          },
          "existing": {
            "$ref": "#/components/schemas/PayeeReference",
            "description": "The payee that already has the name, archived or not."
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "existing"
        ],
        "title": "PayeeNameConflictProblem",
        "description": "A `/problems/name-conflict` problem for a payee's name."
      },
      "PayeePage": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/PayeeResponse"
            },
            "type": "array",
            "title": "Data",
            "description": "The records on this page."
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "description": "The page number, starting at 1."
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize",
            "description": "The most records a page can hold."
          },
          "totalItems": {
            "type": "integer",
            "title": "Totalitems",
            "description": "The number of records across all pages."
          },
          "totalPages": {
            "type": "integer",
            "title": "Totalpages",
            "description": "The number of pages, or 0 when there are no records."
          }
        },
        "type": "object",
        "required": [
          "data",
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "title": "PayeePage",
        "description": "One page of a list of payees."
      },
      "PayeeReference": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "The record's id."
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "description": "The record's name."
          },
          "archivedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archivedat",
            "description": "When the record was archived, or null while it's active."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "archivedAt"
        ],
        "title": "PayeeReference",
        "description": "A payee, nested in another record or a problem."
      },
      "PayeeRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "description": "The payee's name. Surrounding whitespace is trimmed, and it must then be 1 to 100 characters long, with no NUL character."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "PayeeRequest",
        "description": "A payee, as a request to create or update one sends it."
      },
      "PayeeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "The payee's id."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "The payee's name."
          },
          "archivedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archivedat",
            "description": "When the payee was archived, or null while it's active."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "archivedAt"
        ],
        "title": "PayeeResponse",
        "description": "A payee, as the API returns it."
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "A problem type, used as an identifier: a path-absolute URI reference such as `/problems/name-conflict` for 409 and 422 responses, and `about:blank` for every other status. Clients should accept types they don't know."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "A short, fixed summary of the problem type, or the HTTP status phrase for `about:blank`. For display only; match on `type`."
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "The HTTP status code of the response."
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "What went wrong in this request, safe to show to the user."
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemErrorEntry"
            },
            "type": "array",
            "title": "Errors",
            "description": "The problems with individual fields or parameters. Present only when the request had any."
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "title": "Problem",
        "description": "An error response, sent as `application/problem+json` (RFC 9457)."
      },
      "ProblemErrorEntry": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "What is wrong, safe to show to the user."
          },
          "pointer": {
            "type": "string",
            "title": "Pointer",
            "description": "A JSON Pointer (RFC 6901) into the request body, using its camelCase names, such as `/lines/1/itemSizeId`. Present when the problem is in the body."
          },
          "parameter": {
            "type": "string",
            "title": "Parameter",
            "description": "The name of the query or header parameter, as sent, such as `pageSize`. Present when the problem is in a parameter."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ProblemErrorEntry",
        "description": "One problem with a request, located by either `pointer` or `parameter`."
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "build": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "checks"
        ],
        "title": "ReadinessResponse",
        "description": "Whether the app and each subsystem it depends on are ready."
      },
      "SortOrder": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ],
        "title": "SortOrder",
        "description": "Which way a list is sorted."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "UserResponse",
        "description": "A user, as returned by the API."
      }
    }
  }
}
