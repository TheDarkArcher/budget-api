{
  "openapi": "3.1.0",
  "info": {
    "title": "Budget Tracker API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "description": "Report whether the app process is up, without checking any subsystem.\n\nReturns:\n    An ``ok`` status, the app version and the build label, if known.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "The app is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "Report whether the app and each subsystem it depends on are ready.\n\nArgs:\n    checks: The health checks to run.\n    response: The outgoing response, used to set 503 when not ready.\n\nReturns:\n    The overall readiness and each check's result.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "All subsystems are healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "A subsystem is unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckResult": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "latencyMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latencyms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CheckResult",
        "description": "Result of a single subsystem check."
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok",
          "error"
        ],
        "title": "HealthStatus",
        "description": "Status of the app or one of its subsystems."
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "build": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "LivenessResponse",
        "description": "Whether the app process is up and serving requests."
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "build": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "checks"
        ],
        "title": "ReadinessResponse",
        "description": "Whether the app and each subsystem it depends on are ready."
      }
    }
  }
}
